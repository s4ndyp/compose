# Infisical .env-voorbeeld — kopieer naar .env en vervák alle geheime waarden:
#   cp .env.example .env && chmod 600 .env
# .env bevat geheimen: nooit in git commiten, alleen lokaal op de host bewaren.

# ---- Verplicht: eigen gegenereerde sleutels ----
# 32 hex-tekens:   openssl rand -hex 16
ENCRYPTION_KEY=GENEREER_MET_OPENSSL_RAND_HEX_16
# base64 (44 tekens): openssl rand -base64 32
AUTH_SECRET=GENEREER_MET_OPENSSL_RAND_BASE64_32

# ---- Postgres (gebruikt door de db-service én de backend) ----
POSTGRES_USER=infisical
POSTGRES_PASSWORD=KIES_EEN_STERK_WACHTWOORD

# ---- Verplicht: URL waarmee de browser de app bereikt ----
# Poort 80 is standaard-HTTP, dus geen poortnummer opgeven:
SITE_URL=http://LXC-IP-HIER

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Optioneel: SMTP voor uitnodigingen / wachtwoord-reset ----
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Infisical
