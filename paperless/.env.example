# Paperless-ngx — verplichte stack-variabelen.
# Zet deze in de Dockhand-stack-env (of haal ze uit Infisical-map /paperless).
# Committe NOOIT een echte .env; dit bestand is alleen een voorbeeld.

# Postgres-wachtwoord voor de paperless-db.
PAPERLESS_DBPASS=

# Django SECRET_KEY (lange random waarde; MOET gelijk blijven aan de bestaande
# installatie, anders verlopen sessies/tokens). Genereer: openssl rand -hex 32
PAPERLESS_SECRET_KEY=

# django-allauth OIDC-config (Pocket ID). Eén regel JSON.
# Voorbeeld: {"openid_connect": {"APPS": [{"provider_id": "pocket-id", "name": "Pocket ID",
#   "client_id": "<id>", "secret": "<secret>",
#   "settings": {"server_url": "https://pocket.xdio.nl/.well-known/openid-configuration"}}]}}
PAPERLESS_SOCIALACCOUNT_PROVIDERS=

# Image-tag (upgraden = aanpassen + redeploy). v3 kan alleen vanaf 2.20.15.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.5.1

# Optioneel: hosts die de app accepteert (kale IP-toegang; anders 400 bij v3).
# PAPERLESS_ALLOWED_HOSTS=paperless.xdio.nl,10.5.0.109,localhost,127.0.0.1
